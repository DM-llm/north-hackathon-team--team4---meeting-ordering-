# NAC / LLM Runtime 环境变量示例
# 复制为 .env，不要提交真实密钥。

# NAC / North Gate OpenAI-compatible API base URL
OPENAI_BASE_URL=https://northgate.xiaobei.top/v1

# NAC API Key 或兼容 OpenAI API Key
OPENAI_API_KEY=sk-your-nac-api-key-here

# 也可使用 NAC_API_KEY 作为别名
NAC_API_KEY=sk-your-nac-api-key-here

# 当前默认模型
OPENAI_MODEL=nex-agi/Nex-N2-Pro-RS

# 本地 API 端口
PORT=3001

# SQLite 数据库文件路径
DATABASE_URL=file:./data/meeting-ordering.sqlite3

# 当缺少 API Key 时，API 使用本地确定性解析兜底；生产/演示建议设为 true 或留空
ALLOW_LOCAL_AGENT_FALLBACK=true
